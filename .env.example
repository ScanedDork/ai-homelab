# Copy to .env (git-ignored) and fill in. One file is shared by every
# component; scripts and the Makefile pass it with --env-file.
#
# IP placeholders default to 127.0.0.1 on purpose: if you forget to set them,
# services bind to loopback only (fail closed) instead of a public interface.

# --- General ---------------------------------------------------------------
TZ=Europe/Prague

# --- n8npi (Raspberry Pi) ---------------------------------------------------
# Output of `tailscale ip -4` on n8npi.
PI_TAILSCALE_IP=127.0.0.1
# Docker Hub image (deliberately not the n8n private registry).
N8N_IMAGE=docker.io/n8nio/n8n:latest
N8N_PLATFORM=linux/arm64
N8N_PORT=5678
N8N_HOST=n8npi
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8npi:5678/
# Plain HTTP over the (WireGuard-encrypted) tailnet needs this false.
# Set true if you front n8n with `tailscale serve` (HTTPS).
N8N_SECURE_COOKIE=false
# Generate once with: openssl rand -hex 32
# If you are adopting an existing n8n volume, copy the existing key from
# /home/node/.n8n/config instead, or saved credentials become unreadable.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Reuse your existing volume name here if you already run n8n.
N8N_VOLUME_NAME=n8n_data
N8N_CONTAINER=n8n

# --- Backups (Pi) -----------------------------------------------------------
BACKUP_DIR=/srv/n8n-backups
BACKUP_RETENTION=14
BACKUP_HELPER_IMAGE=docker.io/library/alpine:3.20

# --- Dashboard (dashboard/, served on n8npi) ---------------------------------
# Generate with: openssl rand -hex 32. Required by every /api call.
DASHBOARD_TOKEN=replace-with-openssl-rand-hex-32
DASHBOARD_PORT=8080
DASHBOARD_URL=http://n8npi:8080
# Backups older than this show as WARN on the dashboard.
BACKUP_MAX_AGE_HOURS=36

# --- Endpoints used by scripts/healthcheck.sh -------------------------------
N8N_URL=http://n8npi:5678
OLLAMA_URL=http://dorkmini:11434
LITELLM_URL=http://n8npi:4000
# Leave empty until OpenClaw is deployed (the check then shows SKIP).
OPENCLAW_URL=
# Space-separated models that must be present on dorkmini.
HEALTHCHECK_REQUIRED_MODELS=qwen3.5:4b

# --- dorkmini (Mac Mini) ----------------------------------------------------
# Output of `tailscale ip -4` on dorkmini. Used by mac/install-ollama-launchd.sh.
MAC_TAILSCALE_IP=127.0.0.1
# Optional extra (larger) models to pull on dorkmini, space-separated.
MAC_EXTRA_MODELS=

# --- LiteLLM proxy ----------------------------------------------------------
# Multi-arch (amd64 + arm64). Config tested with LiteLLM 1.108.0; pin a
# version tag here for reproducible updates.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_MASTER_KEY=sk-replace-me
OLLAMA_API_BASE=http://dorkmini:11434
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- OpenClaw gateway (see openclaw/README.md) ------------------------------
# Official multi-arch image; pin a release tag (e.g. 2026.9.3) for stability.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Tailscale IP of the host that runs OpenClaw (recommended: n8npi).
OPENCLAW_BIND_IP=127.0.0.1
OPENCLAW_PORT=18789
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32
# Host directories, owned by uid/gid 1000 (the image's node user).
OPENCLAW_HOST_CONFIG_DIR=/srv/openclaw/config
OPENCLAW_HOST_WORKSPACE_DIR=/srv/openclaw/workspace
OPENCLAW_HOST_SECRETS_DIR=/srv/openclaw/auth-secrets

# --- Hermes containers on the Pi (optional, see pi/docker-compose.yml) -----
# Official multi-arch image (linux/amd64 + linux/arm64).
HERMES_IMAGE=docker.io/nousresearch/hermes-agent:latest
# One subdirectory per instance (hermes-1, hermes-2, ...) becomes its HERMES_HOME.
HERMES_DATA_ROOT=/srv/hermes
# Owner of the instance directories (the image remaps its hermes user to these).
HERMES_UID=1000
HERMES_GID=1000

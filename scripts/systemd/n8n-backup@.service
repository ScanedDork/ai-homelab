# Nightly n8n backup, run as the given user (must be in the docker group).
# Install (repo cloned to /opt/ai-homelab; edit paths if elsewhere):
#   sudo cp scripts/systemd/n8n-backup@.service scripts/systemd/n8n-backup@.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now n8n-backup@$USER.timer
# Check: systemctl list-timers 'n8n-backup*'; journalctl -u n8n-backup@$USER

[Unit]
Description=Back up the n8n data volume (user %i)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=/opt/ai-homelab
ExecStart=/opt/ai-homelab/scripts/backup-n8n.sh
Nice=10
IOSchedulingClass=idle

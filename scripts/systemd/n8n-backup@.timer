# Timer for n8n-backup@.service: daily at 03:15 local time (Europe/Prague).
# Persistent=true runs a missed backup after the Pi was powered off.

[Unit]
Description=Nightly n8n backup (user %i)

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target

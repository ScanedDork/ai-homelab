# Hermes Agent config template -> ~/.hermes/config.yaml (host install), or
# HERMES_DATA_ROOT/hermes-N/config.yaml for a Pi container instance.
#   cp hermes/config.yaml.template ~/.hermes/config.yaml
# Merge into your existing file rather than overwriting other settings.
# Key names match upstream cli-config.yaml.example (model.default /
# model.provider / model.base_url / model.api_key).

model:
  # Default model served by Ollama on dorkmini.
  default: "qwen3.5:4b"
  # "custom" = any OpenAI-compatible endpoint ("ollama" is an alias of it).
  provider: "custom"
  base_url: "http://dorkmini:11434/v1"
  # Ollama needs no key.

# Alternative: route through LiteLLM on the Pi for automatic cloud fallback.
# model:
#   default: "local-chat"
#   provider: "custom"
#   base_url: "http://n8npi:4000/v1"
#   # LITELLM_MASTER_KEY or a LiteLLM virtual key. This file then holds a
#   # secret: keep it chmod 600 and outside any git repo.
#   api_key: "REPLACE_WITH_LITELLM_KEY"
